# ---------------------------------------------------------------------------
# Arnold, Phase 0 (single app, SQLite, in-process execution, no auth)
#
# Copy this file to `.env.local` AT THE REPO ROOT. That one file is the only
# place these values live.
#
# Neither tool finds it on its own: the Prisma CLI only reads `.env` from its own
# working directory, and Next only reads env files from `apps/web`. So
# `scripts/with-env.mjs` injects this file for the CLI scripts and
# `apps/web/next.config.mjs` loads it for the web app. Do not copy these values
# into `packages/core/.env` or `apps/web/.env.local`; you would then have three
# copies to keep in step.
# ---------------------------------------------------------------------------

# Store. Relative SQLite paths resolve against the schema file, so this lands at
# packages/core/prisma/arnold.db. Phase 1 swaps it for a postgresql:// URL.
DATABASE_URL="file:./arnold.db"

# The only secret Phase 0 needs. Lives in the same process as the web tier for
# now; Phase 1 moves it to the worker and the web tier stops seeing it.
ANTHROPIC_API_KEY=

# Where leased git worktrees are created. One bare mirror per repo lives under
# <ARNOLD_WORKSPACE_ROOT>/mirrors, one worktree per run under /worktrees.
#
# LEAVE THIS UNSET unless you have a reason. The default is
# <os tmpdir>/arnold-workspaces, deliberately OUTSIDE this repo: a worktree holds
# a full checkout of the target repo, and inside the repo the Next dev watcher,
# tsc and knip would all try to treat it as source.
#
# A relative value here resolves against the repo root, never the current working
# directory (which is apps/web for `pnpm dev` and packages/core for `pnpm seed`).
# ARNOLD_WORKSPACE_ROOT=

# Where collected artifacts are stored. Phase 1 swaps this for an object store.
ARNOLD_ARTIFACT_ROOT=./.arnold/artifacts

# ---------------------------------------------------------------------------
# The target repo: the project whose .claude/ agents Arnold runs.
#
# TARGET_REPO_PATH is a local checkout, used as the clone source for the bare
# mirror, so Phase 0 needs no network and no deploy key. Point it at any repo
# with a .claude/ directory.
#
# TARGET_REPO_SLUG is more than a label: `registry/<slug>/` is where Arnold looks
# up this repo's manifests. If you change it, add a matching directory under
# registry/ and register it in registry/index.ts. Leave it unset to use the
# bundled reference registry at registry/example-repo/.
#
# These seed the FIRST repo row only. An empty database has no console to add a
# row from; after that, repositories are managed at /repos in the app. Re-running
# `pnpm seed` upserts this one row and leaves console-added repos alone.
# ---------------------------------------------------------------------------
TARGET_REPO_PATH=
TARGET_REPO_REMOTE=https://github.com/your-account/your-repo.git
# TARGET_REPO_SLUG=example-repo
# TARGET_REPO_NAME=Example Repo

# Shown as the operator on every run until Phase 3 adds real auth.
# ARNOLD_OPERATOR_EMAIL=operator@localhost

# Global daily spend cap in USD, enforced before a run is allowed to start.
ARNOLD_DAILY_COST_CAP_USD=10
